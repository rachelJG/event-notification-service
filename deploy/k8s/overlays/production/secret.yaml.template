# Production environment secrets template
# DO NOT commit the generated secret.yaml file
# Usage: envsubst < secret.yaml.template > secret.yaml
apiVersion: v1
kind: Secret
metadata:
  name: event-service-secret
  labels:
    app.kubernetes.io/name: event-service
    app.kubernetes.io/environment: production
type: Opaque
stringData:
  PG_DSN: "${PG_DSN}"
  JWT_SECRET: "${JWT_SECRET}"
  SMTP_HOST: "${SMTP_HOST}"
  SMTP_USER: "${SMTP_USER}"
  SMTP_PASSWORD: "${SMTP_PASSWORD}"
  SMTP_FROM: "${SMTP_FROM}"
  JWT_ISSUER: "${JWT_ISSUER:-}"
  JWT_AUDIENCE: "${JWT_AUDIENCE:-}"
