API_ADDR=:8080
PG_DSN=postgres://postgres:postgres@localhost:5432/events?sslmode=disable
LOG_LEVEL=info
APP_ENV=development
JWT_SECRET=change-me-must-be-at-least-32-bytes
JWT_ISSUER=
JWT_AUDIENCE=
TLS_CERT_FILE=
TLS_KEY_FILE=
MAX_BODY_BYTES=1048576
RATE_LIMIT_RPS=10
RATE_LIMIT_BURST=20
READ_HEADER_TIMEOUT=5
READ_TIMEOUT=15
WRITE_TIMEOUT=15
IDLE_TIMEOUT=60
DB_QUERY_TIMEOUT=5
DB_POOL_MAX_CONNS=10
DB_POOL_MIN_CONNS=2
DB_POOL_MAX_CONN_LIFETIME=3600
DB_POOL_MAX_CONN_IDLE_TIME=1800
CORS_ALLOW_ALL=true
CORS_ALLOWED_ORIGINS=
CORS_ALLOWED_HEADERS=Origin,Content-Length,Content-Type,Idempotency-Key,Authorization
HSTS_ENABLED=false
HSTS_MAX_AGE_SECONDS=31536000
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=
